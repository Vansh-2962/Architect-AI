# Local development only. Replace this with your Neon connection string later.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/system_designer?schema=public"
# Optional for Neon: set this to the unpooled connection URL used by Prisma Migrate.
# DIRECT_URL="postgresql://..."

# Development-only value. Generate a unique secret before deploying:
# openssl rand -base64 32
BETTER_AUTH_SECRET="local-only-change-this-secret-before-deploying-123456789"
BETTER_AUTH_URL="http://localhost:3000"
WEB_ORIGIN="http://localhost:5173"
PORT=3000
# Required for AI design generation. Create a key at https://console.groq.com/keys.
GROQ_API_KEY=""
